{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit|mcp__.*",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/smoke-guard.mjs\" \"${CLAUDE_PLUGIN_ROOT}\"", "timeout": 10 }
        ]
      }
    ]
  }
}
